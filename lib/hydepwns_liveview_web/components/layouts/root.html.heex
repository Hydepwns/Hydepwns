<!DOCTYPE html>
<html lang="en" data-theme>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · Hydepwns">
      <%= assigns[:page_title] || "Home" %>
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}></script>
    <script>
      // Set theme based on user preference or system theme
      const setThemeClass = () => {
        const storedTheme = localStorage.getItem('theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        
        // Remove all theme classes
        document.body.classList.remove('light-theme', 'dark-theme', 'dim-theme');
        
        // Apply the appropriate theme
        if (storedTheme) {
          document.body.classList.add(`${storedTheme}-theme`);
        } else if (systemPrefersDark) {
          document.body.classList.add('dark-theme');
        } else {
          document.body.classList.add('light-theme');
        }
      };

      // Set theme on page load
      document.addEventListener('DOMContentLoaded', setThemeClass);
      
      // Listen for theme changes
      window.addEventListener('storage', (e) => {
        if (e.key === 'theme') setThemeClass();
      });
    </script>
  </head>
  <body class={@theme_class}>
    <%= @inner_content %>
  </body>
</html>
