<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Resources</h1>
    <div class="flex space-x-4">
      <.link navigate={~p"/events"} class="text-blue-600 hover:text-blue-800" data-test-id="events-link">
        Events
      </.link>
      <.link navigate={~p"/account"} class="text-blue-600 hover:text-blue-800" data-test-id="account-link">
        Account
      </.link>
    </div>
  </div>

  <!-- Debug output for flash messages -->
  <div class="bg-yellow-100 p-4 mb-4 rounded border border-yellow-300">
    <p class="text-sm font-bold text-yellow-800">Flash Debug:</p>
    <p class="text-sm text-yellow-700">Flash contents: <%= inspect(@flash) %></p>
    <p class="text-sm text-yellow-700">Flash keys: <%= inspect(Map.keys(@flash)) %></p>
    <p class="text-sm text-yellow-700">Info flash: <%= inspect(@flash[:info]) %></p>
    <p class="text-sm text-yellow-700">Error flash: <%= inspect(@flash[:error]) %></p>
  </div>

  <.flash_group flash={@flash} />

  <!-- Debug output -->
  <div class="bg-gray-100 p-4 mb-4 rounded">
    <p class="text-sm text-gray-600">Debug Info:</p>
    <p class="text-sm text-gray-600">Number of resources: <%= length(@resources) %></p>
    <p class="text-sm text-gray-600">Current user: <%= inspect(@current_user) %></p>
  </div>

  <div class="mb-8">
    <div class="flex justify-between items-center mb-4">
      <.link navigate={~p"/resources/new"} class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" data-test-id="create-resource-link">
        Create New Resource
      </.link>

      <div class="flex items-center space-x-4">
        <label for="type-filter" class="text-sm font-medium text-gray-700">Filter by Type:</label>
        <select id="type-filter" name="type" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md" phx-change="filter">
          <option value="">All Types</option>
          <option value="document">Document</option>
          <option value="task">Task</option>
          <option value="note">Note</option>
        </select>
      </div>
    </div>
  </div>

  <div class="bg-white shadow overflow-hidden sm:rounded-md">
    <ul role="list" class="divide-y divide-gray-200">
      <%= for resource <- @resources do %>
        <li>
          <div class="px-4 py-4 sm:px-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center">
                <.link navigate={~p"/resources/#{resource.id}"} class="text-lg font-medium text-blue-600 hover:text-blue-800" data-test-id={"resource-link-#{resource.id}"}>
                  <%= resource.name %>
                </.link>
                <span class="ml-2 px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                  <%= resource.type %>
                </span>
              </div>
              <div class="flex space-x-4">
                <.link navigate={~p"/resources/#{resource.id}/edit"} class="text-blue-600 hover:text-blue-800" data-test-id={"edit-resource-link-#{resource.id}"}>
                  Edit
                </.link>
                <button phx-click="delete" phx-value-id={resource.id} data-confirm="Are you sure you want to delete this resource?" class="text-red-600 hover:text-red-800" data-test-id={"delete-resource-link-#{resource.id}"}>
                  Delete
                </button>
              </div>
            </div>
            <div class="mt-2 sm:flex sm:justify-between">
              <div class="sm:flex">
                <p class="flex items-center text-sm text-gray-500">
                  <%= resource.description %>
                </p>
              </div>
              <div class="mt-2 flex items-center text-sm text-gray-500 sm:mt-0">
                <p>
                  Created <%= Calendar.strftime(resource.inserted_at, "%B %d, %Y") %>
                </p>
              </div>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
</div>
