<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Edit Resource</h1>
    <div class="flex space-x-4">
      <.link navigate={~p"/resources/#{@resource.id}"} class="text-blue-600 hover:text-blue-800">
        Back to Resource
      </.link>
    </div>
  </div>

  <.live_component module={HydepwnsLiveviewWeb.ResourceFormComponent} id={@resource.id} title={@page_title} action={:edit} resource={@resource} resources={@resources} navigate={~p"/resources/#{@resource.id}"} parent_pid={self()} flash_messages={@flash} />
</div>
