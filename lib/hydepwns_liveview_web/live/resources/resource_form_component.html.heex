<div>
  <%= if @flash && @flash[:info] do %>
    <div class="alert alert-info" data-test-id="flash-info">
      <%= @flash[:info] %>
    </div>
  <% end %>

  <.form :let={f} for={@changeset} id="resource-form" phx-target={@myself} phx-change="validate" phx-submit="save">
    <div class="space-y-6">
      <div>
        <.input field={f[:name]} type="text" label="Name" />
        <.error :for={msg <- f[:name].errors} data-test-id="name-error"><%= translate_error(msg) %></.error>
      </div>

      <div>
        <.input
          field={f[:type]}
          type="select"
          label="Type"
          options={[
            {"-- Select --", ""},
            {"Document", "document"},
            {"Task", "task"},
            {"Note", "note"}
          ]}
        />
        <.error :for={msg <- f[:type].errors} data-test-id="type-error"><%= translate_error(msg) %></.error>
      </div>

      <div>
        <.input
          field={f[:status]}
          type="select"
          label="Status"
          options={[
            {"-- Select --", ""},
            {"Draft", "draft"},
            {"Published", "published"},
            {"Archived", "archived"},
            {"Deleted", "deleted"}
          ]}
        />
        <.error :for={msg <- f[:status].errors} data-test-id="status-error"><%= translate_error(msg) %></.error>
      </div>

      <div>
        <.input field={f[:description]} type="textarea" label="Description" />
        <.error :for={msg <- f[:description].errors} data-test-id="description-error"><%= translate_error(msg) %></.error>
      </div>

      <div>
        <.input field={f[:content]} type="textarea" label="Content (JSON)" />
        <.error :for={msg <- f[:content].errors} data-test-id="content-error"><%= translate_error(msg) %></.error>
      </div>

      <div>
        <.input
          field={f[:parent_id]}
          type="select"
          label="Parent Resource"
          options={[
            {"None", nil} | Enum.map(@resources, &{&1.name, &1.id})
          ]}
        />
        <.error :for={msg <- f[:parent_id].errors} data-test-id="parent-id-error"><%= translate_error(msg) %></.error>
      </div>

      <div>
        <.input field={f[:tags]} type="text" label="Tags (comma-separated)" />
        <.error :for={msg <- f[:tags].errors} data-test-id="tags-error"><%= translate_error(msg) %></.error>
      </div>

      <div>
        <.input field={f[:categories]} type="text" label="Categories (comma-separated)" />
        <.error :for={msg <- f[:categories].errors} data-test-id="categories-error"><%= translate_error(msg) %></.error>
      </div>

      <div class="flex justify-end space-x-4">
        <.link navigate={@navigate} data-test-id="cancel-resource-link" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
          Cancel
        </.link>
        <.button type="submit" phx-disable-with="Saving...">
          Save Resource
        </.button>
      </div>
    </div>
  </.form>
  <div class="mt-4">
    <.link navigate={@navigate} data-test-id="back-to-resources-link" class="text-blue-600 hover:text-blue-800">
      Back to Resources
    </.link>
  </div>
</div>
