{
  "name": "hydepwns",
  "version": "1.0.0",
  "description": "Documentation and project management tools",
  "scripts": {
    "test:components": "jest --config test/hydepwns_liveview_web/js/jest.config.js",
    "test:components:watch": "jest --config test/hydepwns_liveview_web/js/jest.config.js --watch",
    "test:components:coverage": "jest --config test/hydepwns_liveview_web/js/jest.config.js --coverage",
    "lint:md": "remark docs/**/*.md -f",
    "lint:md:fix": "node scripts/fix_markdown_validation.js",
    "validate:docs": "node scripts/fix_markdown_validation.js --validate-only",
    "docs:validate": "scripts/ci_documentation_validation.sh",
    "docs:maintain": "scripts/documentation_maintenance.sh",
    "docs:search": "scripts/enhance_doc_search.js",
    "docs:metrics": "scripts/doc_metrics.js",
    "docs:archive": "scripts/enhanced_prd_archive.js",
    "docs:fix:structure": "scripts/fix_doc_structure.js",
    "docs:fix:metadata": "scripts/fix_doc_metadata.js",
    "docs:fix:links": "scripts/fix_doc_links.js",
    "docs:fix:files": "scripts/ensure_required_files.js",
    "docs:fix:all": "npm run docs:fix:files && npm run docs:fix:structure && npm run docs:fix:metadata && npm run docs:fix:links",
    "docs:weekly": "npm run docs:validate && npm run docs:maintain && npm run docs:search && npm run docs:metrics",
    "test:coverage": "jest --coverage",
    "coverage:report": "jest --coverage && node test/hydepwns_liveview_web/js/scripts/coverage-report.js",
    "coverage:watch": "jest --coverage --watch"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "babel-jest": "^29.7.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "chai": "^5.2.0",
    "glob": "^11.0.1",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "remark-cli": "^12.0.1",
    "remark-lint-code-block-style": "^4.0.1",
    "remark-lint-fenced-code-flag": "^4.1.1",
    "remark-lint-heading-increment": "^4.0.1",
    "remark-lint-list-item-indent": "^4.0.1",
    "remark-lint-maximum-line-length": "^4.1.1",
    "remark-lint-no-dead-urls": "^2.0.1",
    "remark-lint-no-missing-blank-lines": "^4.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "sinon": "^19.0.2"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  }
}
