defmodule HydepwnsLiveview.Utils.RelationshipValidatorTest do
  use ExUnit.Case, async: true

  alias HydepwnsLiveview.Utils.RelationshipValidator
  alias HydepwnsLiveview.Resources.UserResource
  alias HydepwnsLiveview.Resources.TeamResource
  alias HydepwnsLiveview.Resources.PostResource

  # Create test data structs with metadata - same helpers as in resolver test
  def create_test_user(attrs \\ %{}) do
    user = struct(
      %{
        id: "user-1",
        name: "Test User",
        email: "test@example.com",
        team_id: "team-1",
        __resource_module__: UserResource
      },
      attrs
    )

    # Add relationship cache if provided
    case Map.get(attrs, :__relationship_cache__) do
      nil -> user
      cache -> Map.put(user, :__relationship_cache__, cache)
    end
  end

  def create_test_team(attrs \\ %{}) do
    team = struct(
      %{
        id: "team-1",
        name: "Test Team",
        description: "A test team",
        __resource_module__: TeamResource
      },
      attrs
    )

    # Add relationship cache if provided
    case Map.get(attrs, :__relationship_cache__) do
      nil -> team
      cache -> Map.put(team, :__relationship_cache__, cache)
    end
  end

  def create_test_post(attrs \\ %{}) do
    post = struct(
      %{
        id: "post-1",
        title: "Test Post",
        content: "Post content",
        author_id: "user-1",
        team_id: "team-1",
        __resource_module__: PostResource
      },
      attrs
    )

    # Add relationship cache if provided
    case Map.get(attrs, :__relationship_cache__) do
      nil -> post
      cache -> Map.put(post, :__relationship_cache__, cache)
    end
  end

  describe "validate_relationship/4" do
    test "validates a belongs_to relationship" do
      user = create_test_user()

      # Mock the load function
      :meck.new(TeamResource, [:passthrough])
      :meck.expect(TeamResource, :load, fn _id -> 
        {:ok, create_test_team()} 
      end)

      try
        # Validate the relationship
        errors = RelationshipValidator.validate_relationship(user, :team)
        
        # Should not have any errors
        assert errors == []
      after
        if :meck.validate(TeamResource) do
          :meck.unload(TeamResource)
        end
      end
    end

    test "returns errors for invalid foreign key" do
      # Create a user with an invalid team_id
      user = create_test_user(%{team_id: "non-existent-team"})

      # Mock the load function to return an error
      :meck.new(TeamResource, [:passthrough])
      :meck.expect(TeamResource, :load, fn _id -> 
        {:error, "Record not found"} 
      end)

      try
        # Validate the relationship
        errors = RelationshipValidator.validate_relationship(user, :team)
        
        # Should have an error
        assert length(errors) > 0
        assert hd(errors).relationship == :team
        assert hd(errors).foreign_key == :team_id
        assert hd(errors).foreign_key_value == "non-existent-team"
      after
        if :meck.validate(TeamResource) do
          :meck.unload(TeamResource)
        end
      end
    end
    test "validates missing required relationship" do
      # Create a user with no team_id
      user = create_test_user(%{team_id: nil})

      # Get the team relationship
      team_rel = HydepwnsLiveview.Utils.RelationshipResolver.get_relationship_definition(
        UserResource,
        :team
      )

      # Create a modified version with required: true
      required_team_rel = Map.put(team_rel, :required, true)

      # Mock to return our modified version
      :meck.new(HydepwnsLiveview.Utils.RelationshipResolver, [:passthrough])
      :meck.expect(
        HydepwnsLiveview.Utils.RelationshipResolver,
        :get_relationship_definition,
        fn _m, :team -> required_team_rel end
      )

      try
        # Validate the relationship
        errors = RelationshipValidator.validate_relationship(user, :team)
        
        # Should have an error about required relationship
        assert length(errors) > 0
        assert hd(errors).relationship == :team
        assert String.contains?(hd(errors).error, "Required")
      after
        if :meck.validate(HydepwnsLiveview.Utils.RelationshipResolver) do
          :meck.unload(HydepwnsLiveview.Utils.RelationshipResolver)
        end
      end

    test "skips referential integrity check when disabled" do
      # Create a user with an invalid team_id
      user = create_test_user(%{team_id: "non-existent-team"})

      # No need to mock TeamResource.load since we won't call it

      # Validate the relationship with referential integrity check disabled
      errors = RelationshipValidator.validate_relationship(user, :team, false)
      
      # Should not have any errors
      assert errors == []
    end

    test "returns error for non-existent relationship" do
      user = create_test_user()
      
      errors = RelationshipValidator.validate_relationship(user, :non_existent)
      
      assert length(errors) > 0
      assert hd(errors).relationship == :non_existent
    end
  end

  describe "validate_relationships/2" do
    test "validates all relationships" do
      user = create_test_user()

      # Mock the load function
      :meck.new(TeamResource, [:passthrough])
      :meck.expect(TeamResource, :load, fn _id -> 
        {:ok, create_test_team()} 
      end)

      try
        # Validate all relationships
        result = RelationshipValidator.validate_relationships(user)
        
        # Should be ok
        assert result == :ok
      after
        if :meck.validate(TeamResource) do
          :meck.unload(TeamResource)
        end
      end
    end

    test "returns errors for invalid relationships" do
      # Create a user with an invalid team_id
      user = create_test_user(%{team_id: "non-existent-team"})

      # Mock the load function to return an error
      :meck.new(TeamResource, [:passthrough])
      :meck.expect(TeamResource, :load, fn _id -> 
        {:error, "Record not found"} 
      end)

      try
        # Validate all relationships
        result = RelationshipValidator.validate_relationships(user)
        
        # Should have errors
        assert {:error, errors} = result
        assert length(errors) > 0
        assert hd(errors).relationship == :team
      after
        if :meck.validate(TeamResource) do
          :meck.unload(TeamResource)
        end
      end
    end

    test "returns error if resource module is missing" do
      user = %{id: "user-1", name: "Test User"} # No __resource_module__
      
      result = RelationshipValidator.validate_relationships(user)
      
      assert {:error, _errors} = result
    end
  end

  describe "validate_update/3" do
    test "validates updates that maintain referential integrity" do
      user = create_test_user()

      # Mock the load function
      :meck.new(TeamResource, [:passthrough])
      :meck.expect(TeamResource, :load, fn _id -> 
        {:ok, create_test_team()} 
      end)

      try
        # Validate an update with a valid team_id
        result = RelationshipValidator.validate_update(user, %{team_id: "team-2"})
        
        # Should be ok
        assert result == :ok
      after
        if :meck.validate(TeamResource) do
          :meck.unload(TeamResource)
        end
      end
    end

    test "rejects updates that would break referential integrity" do
      user = create_test_user()

      # Mock the load function to return an error
      :meck.new(TeamResource, [:passthrough])
      :meck.expect(TeamResource, :load, fn "team-3" -> 
        {:error, "Record not found"} 
      end)

      try
        # Validate an update with an invalid team_id
        result = RelationshipValidator.validate_update(user, %{team_id: "team-3"})
        
        # Should have errors
        assert {:error, errors} = result
        assert length(errors) > 0
        assert hd(errors).relationship == :team
      after
        if :meck.validate(TeamResource) do
          :meck.unload(TeamResource)
        end
      end
    end

    test "allows updates when referential integrity check is disabled" do
      user = create_test_user()

      # Validate an update with referential integrity check disabled
      result = RelationshipValidator.validate_update(user, %{team_id: "team-3"}, false)
      
      # Should be ok
      assert result == :ok
    end

    test "handles multiple relationship updates" do
      post = create_test_post()

      # Mock the load functions
      :meck.new(TeamResource, [:passthrough])
      :meck.expect(TeamResource, :load, fn _id -> 
        {:ok, create_test_team()} 
      end)
      
      :meck.new(UserResource, [:passthrough])
      :meck.expect(UserResource, :load, fn _id -> 
        {:ok, create_test_user()} 
      end)

      try
        # Validate updates to multiple relationships
        result = RelationshipValidator.validate_update(
          post, 
          %{team_id: "team-2", author_id: "user-2"}
        )
        
        # Should be ok
        assert result == :ok
      after
        if :meck.validate(TeamResource) do
          :meck.unload(TeamResource)
        end
        
        if :meck.validate(UserResource) do
          :meck.unload(UserResource)
        end
      end
    end

    test "reports all relationship errors" do
      post = create_test_post()

      # Mock the load functions to return errors
      :meck.new(TeamResource, [:passthrough])
      :meck.expect(TeamResource, :load, fn "team-bad" -> 
        {:error, "Record not found"} 
      end)
      
      :meck.new(UserResource, [:passthrough])
      :meck.expect(UserResource, :load, fn "user-bad" -> 
        {:error, "Record not found"} 
      end)

      try
        # Validate updates to multiple relationships, both invalid
        result = RelationshipValidator.validate_update(
          post, 
          %{team_id: "team-bad", author_id: "user-bad"}
        )
        
        # Should have multiple errors
        assert {:error, errors} = result
        assert length(errors) == 2  # One for each relationship
      after
        if :meck.validate(TeamResource) do
          :meck.unload(TeamResource)
        end
        
        if :meck.validate(UserResource) do
          :meck.unload(UserResource)
        end
      end
    end
  end

  describe "validate_delete/2" do
    test "validates delete without dependencies" do
      user = create_test_user()

      # Mock to return empty reverse relationships
      :meck.new(HydepwnsLiveview.Utils.RelationshipValidator, [:passthrough])
      :meck.expect(
        HydepwnsLiveview.Utils.RelationshipValidator,
        :find_reverse_relationships,
        fn _r -> [] end
      )

      try
        # Validate a delete
        result = RelationshipValidator.validate_delete(user)
        
        # Should be ok
        assert result == :ok
      after
        if :meck.validate(HydepwnsLiveview.Utils.RelationshipValidator) do
          :meck.unload(HydepwnsLiveview.Utils.RelationshipValidator)
        end
      end
    end

    test "allows force delete even with dependencies" do
      user = create_test_user()

      # Don't need to mock anything since force: true bypasses the checks

      # Validate a force delete
      result = RelationshipValidator.validate_delete(user, force: true)
      
      # Should be ok
      assert result == :ok
    end
  end
end 
